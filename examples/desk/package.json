{
  "name": "@acme/desk",
  "version": "1.0.0",
  "description": "A customer-support desk that sends each request to the model fit for what it contains.",
  "private": true,
  "type": "module",
  "main": "src/motty.ts",
  "scripts": {
    "build": "bun build src/motty.ts --target=node --outfile=dist/motty.js",
    "test": "bun test ./test",
