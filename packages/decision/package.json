{
  "name": "@mottyjs/decision",
  "version": "0.1.1",
  "description": "Decision models for a motty: choice, score and noul questions answered with probabilities.",
  "keywords": [
    "motty",
    "llm",
    "gateway",
    "decision-model",
    "classification",
    "bun"
  ],
  "license": "Apache-2.0",
  "author": "Skrrt LLC",
  "homepage": "https://github.com/skrrt-sh/motty-sdk/tree/main/packages/decision#readme",
  "bugs": "https://github.com/skrrt-sh/motty-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrrt-sh/motty-sdk.git",
    "directory": "packages/decision"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "@mottyjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./wire": {
      "@mottyjs/source": "./src/wire.ts",
      "types": "./dist/wire.d.ts",
      "default": "./src/wire.ts"
    }
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. declarations && rm -rf dist && cp -R ../../dist/decision/src dist"
  },
  "dependencies": {
    "@mottyjs/core": "workspace:*"
  }
}
