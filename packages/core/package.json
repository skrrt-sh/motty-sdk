{
  "name": "@mottyjs/core",
  "version": "0.1.1",
  "description": "The motty builder, model calls, fallback, race, retry and timeout, error classes and types: all a motty or a plugin needs.",
  "keywords": [
    "motty",
    "llm",
    "gateway",
    "model-routing",
    "fallback",
    "bun",
    "cloudflare-workers"
  ],
  "license": "Apache-2.0",
  "author": "Skrrt LLC",
  "homepage": "https://github.com/skrrt-sh/motty-sdk/tree/main/packages/core#readme",
  "bugs": "https://github.com/skrrt-sh/motty-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrrt-sh/motty-sdk.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "@mottyjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "@mottyjs/source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "bun": "./src/host.ts",
      "default": "./dist/host.js"
    }
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build && rm -rf dist && cp -R ../../dist/core/src dist"
  }
}
