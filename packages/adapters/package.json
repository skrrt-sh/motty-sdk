{
  "name": "@mottyjs/adapters",
  "version": "0.1.1",
  "description": "Host-side adapters for a motty: model providers, Redis and Durable Object storage, and jwt and bearer auth.",
  "keywords": [
    "motty",
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "openrouter",
    "redis",
    "durable-objects",
    "jwt",
    "bun",
    "cloudflare-workers"
  ],
  "license": "Apache-2.0",
  "author": "Skrrt LLC",
  "homepage": "https://github.com/skrrt-sh/motty-sdk/tree/main/packages/adapters#readme",
  "bugs": "https://github.com/skrrt-sh/motty-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrrt-sh/motty-sdk.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./openai": {
      "@mottyjs/source": "./src/openai.ts",
      "types": "./dist/openai.d.ts",
      "bun": "./src/openai.ts",
      "default": "./dist/openai.js"
    },
    "./anthropic": {
      "@mottyjs/source": "./src/anthropic.ts",
