    },
    "./jwt": {
      "@mottyjs/source": "./src/jwt.ts",
      "types": "./dist/jwt.d.ts",
      "bun": "./src/jwt.ts",
      "default": "./dist/jwt.js"
    }
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build && rm -rf dist && cp -R ../../dist/adapters/src dist"
  },
  "dependencies": {
    "@mottyjs/core": "workspace:*",
    "@mottyjs/serve": "workspace:*",
    "jose": "catalog:"
