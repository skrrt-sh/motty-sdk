      "default": "./dist/minimax.js"
    },
    "./groq": {
      "@mottyjs/source": "./src/groq.ts",
      "types": "./dist/groq.d.ts",
      "bun": "./src/groq.ts",
      "default": "./dist/groq.js"
    },
    "./mistral": {
      "@mottyjs/source": "./src/mistral.ts",
