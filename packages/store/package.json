{
  "name": "@mottyjs/store",
  "version": "0.1.1",
  "description": "Key-value storage for a motty, kept in whatever storage its host supplies.",
  "keywords": [
    "motty",
    "llm",
    "gateway",
    "key-value",
    "storage",
    "bun",
    "node",
    "deno",
    "cloudflare-workers"
  ],
  "license": "Apache-2.0",
  "author": "Skrrt LLC",
  "homepage": "https://github.com/skrrt-sh/motty-sdk/tree/main/packages/store#readme",
  "bugs": "https://github.com/skrrt-sh/motty-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrrt-sh/motty-sdk.git",
    "directory": "packages/store"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "@mottyjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "bun run --cwd ../.. build && rm -rf dist && cp -R ../../dist/store/src dist"
  },
  "dependencies": {
    "@mottyjs/core": "workspace:*"
  }
}
