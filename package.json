{
  "name": "motty",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.6.3",
      "@types/bun": "1.4.4",
      "jose": "^6.2.12",
      "playwright": "1.64.1",
      "typescript": "7.0.2",
      "zod": "^4"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:browser": "bun test --timeout 20000 ./examples/coder/browser/chat.browser.ts",
    "test:live": "bun test --timeout 60000 ./packages/adapters/test/openrouter.live.ts ./packages/adapters/test/openrouter-media.live.ts ./packages/adapters/test/openrouter-output.live.ts ./packages/adapters/test/openai.live.ts ./packages/adapters/test/anthropic.live.ts ./packages/adapters/test/claude-code.live.ts ./packages/adapters/test/codex.live.ts ./packages/adapters/test/responses-reasoning.live.ts ./packages/adapters/test/openrouter-open-weight.live.ts ./packages/adapters/test/across-families.live.ts ./packages/adapters/test/responses-gaps.live.ts ./packages/adapters/test/mistral.live.ts ./packages/adapters/test/together.live.ts ./packages/adapters/test/fireworks.live.ts ./packages/adapters/test/typesafe.live.ts ./packages/adapters/test/takes.live.ts",
    "record": "RECORD=1 bun test gates",
    "bump": "bun scripts/bump.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.99",
    "@biomejs/biome": "catalog:",
    "@langchain/core": "1.3.0",
    "@langchain/openai": "1.7.0",
    "@mastra/core": "1.79.0",
    "@mottyjs/core": "workspace:*",
    "@mottyjs/serve": "workspace:*",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-openai": "1.0.0",
    "@types/bun": "catalog:",
    "ai": "7.0.153",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "workerd": "1.20261025.1",
    "zod": "catalog:"
  }
}
