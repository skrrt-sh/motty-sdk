{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],
    "customConditions": ["@mottyjs/source"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },

  "include": [
    "packages/*/src",
    "packages/*/test",
    "gates",
    "scripts",
    "examples/*/src",
    "examples/*/test",
    "examples/*/evals",
    "examples/*/demo",
    "examples/*/browser"
  ],
  // Read with the Workers types alone, by tsconfig.workers.json.
  "exclude": [
    "packages/adapters/src/cloudflare.ts",
    "packages/adapters/test/cloudflare.worker.ts",
    "packages/adapters/test/speed.worker.ts"
  ]
}
